# Resend API key for the contact form. Unset -> ConsoleEmailSender used instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Signs session cookies. MUST be set to a fixed value in production —
# unset, FastHTML auto-generates one into a .sesskey file, which doesn't
# survive a container rebuild and would log the admin out on every deploy.
SESSION_SECRET=

# Shared password for the /admin/* content management routes (no username,
# single-admin site). Unset -> admin login always fails.
ADMIN_PASSWORD=
